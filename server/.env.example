# Server
PORT=3001
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=panniwalay_user
DB_PASSWORD=your_secure_password_here
DB_NAME=panniwalay_erp

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173

# Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# App
APP_NAME=Panniwalay ERP
APP_DOMAIN=panniwalay.com
BASE_CURRENCY=PKR

# Forex (optional, behind a flag)
FOREX_API_ENABLED=false
FOREX_API_KEY=
FOREX_API_URL=
